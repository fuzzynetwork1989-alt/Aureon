{
  "name": "aureon",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rimraf .turbo node_modules",
    "format": "prettier --write .",
    "supabase:start": "pnpm --filter @aureon/supabase start",
    "supabase:reset": "pnpm --filter @aureon/supabase reset",
    "supabase:lint": "pnpm --filter @aureon/supabase lint",
    "supabase:deploy": "pnpm --filter @aureon/supabase deploy"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3"
  }
}
